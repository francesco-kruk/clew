      "checkpoint": {
        "id": "vector-checkpoint",
        "type": "single-choice",
        "prompt": "For A = [[1, 2], [3, 1]] and x = [0, 1]ᵀ, what is Ax?",
        "options": [
          "[2, 1]ᵀ",
          "[1, 3]ᵀ",
          "[0, 1]ᵀ",
          "[3, 3]ᵀ"
