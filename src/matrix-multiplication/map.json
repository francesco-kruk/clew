  "nodes": [
    {
      "id": "one",
      "title": "One number at a time",
      "shortTitle": "1 × 1",
      "categoryId": "the-rule",
      "summary": "A matrix is a rectangular array of numbers. Its shape is written rows × columns. A 1 × 1 matrix has just one entry, so multiplying two of them is ordinary multiplication in brackets.",
      "content": "lessons/one.md",
      "example": {
        "operation": "matrix-multiplication",
        "A": [
          [
            3
          ]
        ],
        "B": [
          [
            4
          ]
        ],
        "expectedProduct": [
          [
            12
          ]
        ]
      },
      "presets": [],
      "checkpoint": {
        "id": "one-checkpoint",
        "type": "numeric",
        "prompt": "What is the only entry of [−2][5]?",
        "answer": -10,
        "tolerance": 1e-9,
        "hint": "Multiply the two entries. A negative times a positive is negative.",
        "explanation": "(−2) × 5 = −10, so the product is [−10]."
      },
      "interactions": [
        "edit-matrices",
        "trace-dot-product"
      ],
      "layout": {
        "x": 135,
        "y": 52
      }
    },
    {
      "id": "dot",
      "title": "A row meets a column",
      "shortTitle": "Dot product",
      "categoryId": "the-rule",
      "summary": "Multiply matching entries, then add the products. This row-by-column calculation is a dot product: it is the single operation behind every entry of a matrix product.",
      "content": "lessons/dot.md",
      "example": {
        "operation": "matrix-multiplication",
        "A": [
          [
            2,
            3,
            -1
          ]
        ],
        "B": [
          [
            4
          ],
          [
            1
          ],
          [
            2
          ]
        ],
        "expectedProduct": [
          [
            9
          ]
        ]
      },
      "presets": [],
      "checkpoint": {
        "id": "dot-checkpoint",
        "type": "numeric",
        "prompt": "Compute [1  −2  3] [4  5  2]ᵀ. What is the result's single entry?",
        "answer": 0,
        "tolerance": 1e-9,
        "hint": "The three terms are 4, −10, and 6.",
        "explanation": "1·4 + (−2)·5 + 3·2 = 4 − 10 + 6 = 0. Nonzero vectors can have zero dot product."
      },
      "interactions": [
        "edit-matrices",
        "trace-dot-product"
      ],
      "layout": {
        "x": 135,
        "y": 137
      }
    },
    {
      "id": "shapes",
      "title": "When a product exists",
      "shortTitle": "Shapes",
      "categoryId": "the-rule",
      "summary": "A row of A must have exactly as many entries as a column of B. That is why A's column count must match B's row count.",
      "content": "lessons/shapes.md",
      "example": {
        "operation": "matrix-multiplication",
        "A": [
          [
            1,
            2,
            3
          ],
          [
            4,
            5,
            6
          ]
        ],
        "B": [
          [
            1,
            0
          ],
          [
            0,
            1
          ],
          [
            1,
            1
          ]
        ],
        "expectedProduct": [
          [
            4,
            5
          ],
          [
            10,
            11
          ]
        ]
      },
      "presets": [
        {
          "id": "small",
          "title": "2 × 3 by 3 × 2",
          "operation": "matrix-multiplication",
          "A": [
            [
              1,
              2,
              3
            ],
            [
              0,
              -1,
              2
            ]
          ],
          "B": [
            [
              1,
              2
            ],
            [
              0,
              1
            ],
            [
              3,
              0
            ]
          ],
          "expectedProduct": [
            [
              10,
              4
            ],
            [
              6,
              -1
            ]
          ]
        },
        {
          "id": "large",
          "title": "3 × 2 by 2 × 4",
          "operation": "matrix-multiplication",
          "A": [
            [
              1,
              2
            ],
            [
              0,
              -1
            ],
            [
              3,
              1
            ]
          ],
          "B": [
