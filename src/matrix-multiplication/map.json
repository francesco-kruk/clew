              0,
              1
            ]
          ],
          "expectedProduct": null
        }
      ],
      "checkpoint": {
        "id": "shapes-checkpoint",
        "type": "single-choice",
        "prompt": "A has shape 3 × 2 and B has shape 2 × 4. What is the shape of AB?",
        "options": [
          "3 × 4",
          "2 × 2",
          "4 × 3",
          "Undefined"
        ],
        "answer": "3 × 4",
        "hint": "Match the two inner dimensions, then keep the outside pair.",
        "explanation": "(3 × 2)(2 × 4) → 3 × 4. There is one output for each of A's three rows and B's four columns."
      },
