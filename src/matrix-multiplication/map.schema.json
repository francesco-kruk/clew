{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning concept map",
  "description": "Version 1 of the portable matrix learning map. Cross-reference and mathematical checks are implemented in validate.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "title", "description", "startNode", "readingOrder", "categories", "nodes", "edges"],
  "properties": {
    "$schema": { "const": "./map.schema.json" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/text" },
    "description": { "$ref": "#/$defs/text" },
    "startNode": { "$ref": "#/$defs/id" },
    "readingOrder": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "categories": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/category" } },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "layout": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "position": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": { "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 } }
    },
    "category": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "description", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "order": { "type": "integer", "minimum": 1 },
        "layout": { "$ref": "#/$defs/position" }
      }
    },
    "matrix": {
      "type": "array", "minItems": 1,
      "items": { "type": "array", "minItems": 1, "items": { "type": "number" } },
      "description": "Row-major, nonempty, rectangular matrix of finite numbers; rectangularity is checked by the validator."
    },
    "product": {
      "anyOf": [{ "$ref": "#/$defs/matrix" }, { "type": "null" }],
      "description": "Null means undefined because the inner dimensions differ, not a zero matrix."
    },
    "example": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "A", "B", "expectedProduct"],
      "properties": {
        "operation": { "const": "matrix-multiplication" },
        "A": { "$ref": "#/$defs/matrix" },
        "B": { "$ref": "#/$defs/matrix" },
        "expectedProduct": { "$ref": "#/$defs/product" }
      }
    },
    "preset": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "operation", "A", "B", "expectedProduct"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "operation": { "const": "matrix-multiplication" },
        "A": { "$ref": "#/$defs/matrix" },
        "B": { "$ref": "#/$defs/matrix" },
        "expectedProduct": { "$ref": "#/$defs/product" }
      }
    },
    "checkpoint": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "type", "prompt", "answer", "tolerance", "hint", "explanation"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "type": { "const": "numeric" },
            "prompt": { "$ref": "#/$defs/text" },
            "answer": { "type": "number" },
            "tolerance": { "type": "number", "exclusiveMinimum": 0 },
            "hint": { "$ref": "#/$defs/text" },
            "explanation": { "$ref": "#/$defs/text" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "type", "prompt", "options", "answer", "hint", "explanation"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "type": { "const": "single-choice" },
            "prompt": { "$ref": "#/$defs/text" },
            "options": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
            "answer": { "$ref": "#/$defs/text" },
            "hint": { "$ref": "#/$defs/text" },
            "explanation": { "$ref": "#/$defs/text" }
          }
        }
      ]
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "shortTitle", "categoryId", "summary", "content", "example", "presets", "checkpoint", "interactions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "shortTitle": { "$ref": "#/$defs/text" },
        "categoryId": { "$ref": "#/$defs/id" },
        "summary": { "$ref": "#/$defs/text" },
        "content": { "type": "string", "pattern": "^lessons/[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.md$" },
        "example": { "$ref": "#/$defs/example" },
        "presets": { "type": "array", "items": { "$ref": "#/$defs/preset" } },
        "checkpoint": { "$ref": "#/$defs/checkpoint" },
        "interactions": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["edit-matrices", "trace-dot-product", "resize-matrices", "reverse-order", "transpose-product", "coordinate-view", "transformation-presets", "zero-matrix-preset"] }
        },
        "layout": { "$ref": "#/$defs/position" }
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false, "required": ["from", "to", "type"],
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "type": { "enum": ["suggested-next", "prerequisite", "related"] },
        "description": { "$ref": "#/$defs/text" }
      }
    }
  }
}
